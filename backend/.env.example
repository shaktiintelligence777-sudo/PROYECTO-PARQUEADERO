# Copia este archivo como .env para desarrollo local. Nunca subas .env al repositorio.

ENTORNO=desarrollo

# PostgreSQL. Acepta postgres://, postgresql:// o postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/parqueadero

# Secreto para firmar JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-caracteres

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=14

# Orígenes permitidos por CORS, separados por comas (el dominio de GitHub Pages en producción).
CORS_ORIGINS=http://localhost:5173

# Rate limit del login
LOGIN_MAX_INTENTOS_EMAIL=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_VENTANA_SEGUNDOS=300

# Token de servicio para /internal/* (job de notificaciones). Mínimo 32 caracteres.
INTERNAL_JOB_TOKEN=

# Usuario administrador inicial (lo crea `python -m app.db.seed`)
SEED_ADMIN_EMAIL=admin@parqueadero.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Administrador
