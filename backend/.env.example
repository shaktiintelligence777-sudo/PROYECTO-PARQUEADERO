# Copia este archivo como backend/.env para desarrollo local. Nunca subas .env al repositorio.

ENTORNO=desarrollo

# PostgreSQL. Acepta postgres://, postgresql:// o postgresql+asyncpg:// (se convierte solo).
# En producción (Neon) usa la cadena tal cual la entrega Neon (?sslmode=require...): la API
# exige TLS verificado y no arranca si la URL trae sslmode=disable, allow o prefer.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parqueadero

# Secretos: mínimo 32 caracteres. Genera cada uno con:
#   openssl rand -base64 48
# En producción se cargan en el panel de Render (ver docs/operacion.md), nunca aquí.
JWT_SECRETO=
SERVICE_TOKEN=

# Orígenes permitidos por CORS, separados por comas. Nunca "*".
CORS_ORIGENES=http://localhost:5173

ZONA_HORARIA=America/Bogota

# Sesión y límite de intentos (valores por defecto de la spec B-03)
JWT_MINUTOS_ACCESO=15
REFRESH_DIAS=30
LOGIN_MAX_FALLOS_EMAIL=5
LOGIN_MAX_FALLOS_IP=20
LOGIN_VENTANA_MINUTOS=15

# Correo de las notificaciones (B-07): consola · smtp · resend.
# Con "consola" no se envía nada: solo se registra el destinatario enmascarado.
CORREO_PROVEEDOR=consola
# Obligatoria con smtp o resend, por ejemplo: Parqueadero <avisos@tu-dominio.com>
CORREO_REMITENTE=
# Solo con smtp (587 = STARTTLS, 465 = TLS directo)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
# Solo con resend
RESEND_API_KEY=
