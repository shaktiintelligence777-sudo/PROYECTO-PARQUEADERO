# mock (demo con datos en el navegador) | live (backend real)
VITE_API_MODE=mock
# URL base del backend, sin barra final (p. ej. https://parqueadero-api.onrender.com).
# Solo se usa en modo live; si falta, la app muestra "Falta configurar la dirección del servidor.".
# En GitHub Pages ambas salen de las variables del repositorio API_MODE y API_URL.
VITE_API_URL=
# Ruta base de Vite (opcional). Por defecto: /PROYECTO-PARQUEADERO/ en build, / en desarrollo.
# VITE_BASE=/PROYECTO-PARQUEADERO/
